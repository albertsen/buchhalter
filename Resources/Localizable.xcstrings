            "value" : "Google Books lässt sich einschalten, sobald unten ein Schlüssel gesichert ist. Sind alle Quellen aus, sind Vervollständigen und Coverbild suchen nicht verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Books can be turned on once a key is saved below. With every source off, Complete and Find Cover are unavailable."
          }
        }
      }
    },
