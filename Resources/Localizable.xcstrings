      }
    },
    "The key is kept in iCloud Keychain, so you enter it once for all your devices that use it. Removing it removes it everywhere." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Schlüssel liegt im iCloud-Schlüsselbund. Du gibst ihn einmal für alle deine Geräte ein, die ihn nutzen. Wenn du ihn entfernst, ist er überall entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The key is kept in iCloud Keychain, so you enter it once for all your devices that use it. Removing it removes it everywhere."
          }
        }
      }
    },
    "The key is kept in iCloud Keychain, so you enter it once for all your devices that use it. Removing it removes it everywhere. Searches send the book's ISBN, or its title and author, to Google." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Schlüssel liegt im iCloud-Schlüsselbund. Du gibst ihn einmal für alle deine Geräte ein, die ihn nutzen. Wenn du ihn entfernst, ist er überall entfernt. Suchen schicken die ISBN des Buchs oder Titel und Autor an Google."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The key is kept in iCloud Keychain, so you enter it once for all your devices that use it. Removing it removes it everywhere. Searches send the book's ISBN, or its title and author, to Google."
          }
        }
      }
    },
